# Maintainer: SamuLibre Security Team <security@samulibre.org>
pkgname=samulibre
pkgver=0.2.1
pkgrel=1
pkgdesc="Suite de Seguridad, EDR y Antivirus Open Source con VPN Tor integrada"
arch=('x86_64')
url="https://github.com/saghet/SamuLibre"
license=('GPL3')
depends=('webkit2gtk-4.1' 'gtk3' 'tor' 'iptables')
optdepends=(
    'libayatana-appindicator: Icono en la bandeja del sistema'
    'kdialog: Diálogos nativos de archivo para KDE Plasma / Garuda Linux'
    'zenity: Diálogos nativos de archivo para GNOME / GTK'
    'snapper: Instantáneas de restauración del sistema Btrfs recomendadas en Garuda Linux'
)
provides=('samulibre')
conflicts=('samulibre-git')
options=('!strip' '!debug')

package() {
    # Binarios
    install -Dm755 "${srcdir}/samulibre-gui" "${pkgdir}/usr/bin/samulibre-gui"
    install -Dm755 "${srcdir}/samulibre-cli" "${pkgdir}/usr/bin/samulibre-cli"
    ln -sf samulibre-cli "${pkgdir}/usr/bin/samulibre"

    # Lanzador de escritorio e iconos
    install -Dm644 "${srcdir}/samulibre.desktop" "${pkgdir}/usr/share/applications/samulibre.desktop"
    install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/samulibre.png"

    # Unidad de systemd
    install -Dm644 "${srcdir}/samulibre.service" "${pkgdir}/usr/lib/systemd/user/samulibre.service"

    # Recursos completos (UI, firmas, catálogo KB, reglas CVE, sandbox, canarios)
    mkdir -p "${pkgdir}/usr/share/samulibre"
    cp -r "${srcdir}/data" "${pkgdir}/usr/share/samulibre/"
}
